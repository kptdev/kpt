apiVersion: kpt.dev/v1
kind: Kptfile
metadata:
  name: app
pipeline:
  mutators:
    - image: ghcr.io/kptdev/krm-functions-catalog/set-namespace:latest
      configMap:
        namespace: prod
      selectors:
        - kind: Deployment
      exclude:
        - name: db
    - image: ghcr.io/kptdev/krm-functions-catalog/set-labels:latest
      configMap:
        app: myapp
      selectors:
        - kind: Service
      exclude:
        - name: legacy-svc
